# ==============================================================================
# U.L.T.R.O.N. OS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and populate with your specific values.
# DO NOT commit '.env' to version control.

# ------------------------------------------------------------------------------
# CORE SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
ULTRON_ENV=development
ULTRON_PORT=3000
ULTRON_LOG_LEVEL=debug
ULTRON_ALLOW_SELF_MODIFICATION=false # Set to true to allow Ultron to edit its own codebase
ULTRON_WORKSPACE_ROOT=/path/to/your/workspaces # Default directory for projects

# ------------------------------------------------------------------------------
# AI PROVIDERS (OMNIROUTE MULTI-BRAIN)
# ------------------------------------------------------------------------------
# You don't need all of these, but configuring multiple allows for failover.

# OPENAI (Premium Reasoning)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o

# ANTHROPIC (Premium Reasoning & Coding)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20240620

# GEMINI (High Context Windows - Free Tier Available)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=AIza...
GEMINI_DEFAULT_MODEL=gemini-1.5-pro

# GROQ (Ultra-Fast LLaMA 3 - Free Tier Available)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_DEFAULT_MODEL=llama3-70b-8192

# OPENROUTER (Aggregator - Many Free Models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3-70b-instruct

# DEEPSEEK (Cost-Effective Coding)
# Get key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_DEFAULT_MODEL=deepseek-coder

# MISTRAL (European Models)
# Get key: https://console.mistral.ai/
MISTRAL_API_KEY=...

# xAI (Grok)
# Get key: https://console.x.ai/
XAI_API_KEY=...

# ------------------------------------------------------------------------------
# LOCAL AI CONFIGURATION (OLLAMA / LM STUDIO)
# ------------------------------------------------------------------------------
# Ensure your local server is running. Leave blank to disable local inference.
LOCAL_AI_ENABLED=false
LOCAL_AI_PROVIDER=ollama # or 'lmstudio'
LOCAL_AI_ENDPOINT=http://localhost:11434
LOCAL_AI_DEFAULT_MODEL=llama3:8b

# ------------------------------------------------------------------------------
# 3D MODEL GENERATION
# ------------------------------------------------------------------------------
# MESHY (Free API Key available at https://meshy.ai)
MESHY_API_KEY=...

# TRIPO3D (Alternative 3D engine)
TRIPO3D_API_KEY=...

# ------------------------------------------------------------------------------
# VOICE & AUDIO (TTS / STT)
# ------------------------------------------------------------------------------
# ELEVENLABS (Premium Ultra-Realistic Voices)
# Get key: https://elevenlabs.io/
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=... # Set your preferred Persona ID (e.g., Jarvis)

# LOCAL TTS PIPER CONFIGURATION
LOCAL_TTS_ENABLED=true
LOCAL_TTS_MODEL_PATH=./models/en_US-lessac-medium.onnx

# WAKE WORD DETECTION (VAD)
VAD_SENSITIVITY=0.5
WAKE_WORDS=ultron,jarvis,friday

# ------------------------------------------------------------------------------
# SCREENPIPE & MEMORY
# ------------------------------------------------------------------------------
# 24/7 Screen and Audio OCR Memory Buffer
SCREENPIPE_ENABLED=true
SCREENPIPE_API_URL=http://localhost:3030

# MEMORY GRAPH DATABASE
# Default uses local SQLite + Vector DB. Specify path here.
MEMORY_DB_PATH=~/.ultron/memory.db
VECTOR_DB_PATH=~/.ultron/chroma_db

# ------------------------------------------------------------------------------
# MCP (MODEL CONTEXT PROTOCOL) SERVERS
# ------------------------------------------------------------------------------
# Paths or URLs to auto-start MCP instances
MCP_GITHUB_ENABLED=false
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

MCP_NOTION_ENABLED=false
NOTION_API_KEY=secret_...

# Path to custom mcp config file
MCP_CONFIG_PATH=~/.ultron/mcp_config.json
