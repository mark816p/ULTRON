{
  "name": "ultron-orb-ui",
  "version": "1.0.1",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "app": "electron .",
    "build:installer": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.antigravity.ultron",
    "productName": "ULTRON",
    "asar": false,
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "mark816p",
        "repo": "ultron-autonomous-orb"
      }
    ],
    "files": [
      ".next/**/*",
      "public/**/*",
      "package.json",
      "main.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "guid": "4A9D38C2-817B-4F29-875D-32A29C5B2A1E",
      "shortcutName": "U.L.T.R.O.N."
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "electron-updater": "^6.8.9",
    "never-forget-engine": "file:../never-forget-engine",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
